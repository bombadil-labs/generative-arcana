{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "arcana": {
      "root": ".",
      "entrypoint": "Dockerfile.vercel",
      "runtime": "container"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "arcana"
      }
    }
  ],
  "git": {
    "deploymentEnabled": {
      "feat/parlor-soft-opening": false,
      "feat/parlor-signal-accents": false,
      "feat/parlor-runtime-transcripts": false,
      "fix/parlor-summon-intent": false,
      "feat/parlor-deck-introduction": false,
      "release/parlor-deck-context-details": false,
      "fix/parlor-slot-caption-geometry": false,
      "feat/parlor-card-details": false,
      "fix/parlor-authored-vision-context": false,
      "docs/arcana-artwork-dimensions": false,
      "feat/parlor-ether-visions": false,
      "feat/parlor-card-focus": false,
      "fix/parlor-projection-captions": false,
      "fix/parlor-narration-recovery": false,
      "feat/parlor-projection-cues": false,
      "feat/parlor-radio-recording": false,
      "feat/parlor-owner-keys": false,
      "feat/parlor-radio-signals": false,
      "feat/parlor-table-controls": false,
      "feat/parlor-conversation": false,
      "staging": false,
      "dependabot/**": false
    }
  }
}
