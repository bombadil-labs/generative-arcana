{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "arcana": {
      "root": ".",
      "entrypoint": "Dockerfile.vercel",
      "runtime": "container"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "arcana"
      }
    }
  ],
  "git": {
    "deploymentEnabled": {
      "feat/parlor-radio-recording": false,
      "feat/parlor-radio-signals": false,
      "feat/parlor-table-controls": false,
      "feat/parlor-conversation": false,
      "staging": false,
      "dependabot/**": false
    }
  }
}
