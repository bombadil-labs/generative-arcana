{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "../app/src/engine/**/*.ts", "../app/src/mcp/**/*.ts", "../app/src/decks/**/*.ts", "../app/src/reading/**/*.ts"]
}
