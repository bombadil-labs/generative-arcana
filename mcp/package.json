    "test:cross-host-account": "tsx test/cross-host-account-flow.ts",
    "test:authoring-api": "tsx test/authoring-api.ts",
    "test:deep-time-v2": "tsx test/deep-time-v2.ts",
    "test:evolution-v2": "tsx test/evolution-v2.ts",
