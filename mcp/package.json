    "test:byrne-v2": "tsx test/byrne-v2.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@neondatabase/serverless": "^1.0.0",
    "tsx": "^4.20.0",
    "zod": "^4.0.0",
    "jose": "^6.1.0",
    "@workos-inc/node": "^10.7.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0"
