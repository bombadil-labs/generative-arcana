{
  "name": "@bombadil-labs/generative-arcana-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Headless MCP server for the Generative Arcana symbolic engine.",
  "scripts": {
    "dev": "tsx src/stdio.ts",
    "start": "tsx src/stdio.ts",
    "http": "tsx src/http.ts",
    "smoke": "npm run smoke:stdio && npm run smoke:http && npm run smoke:http-auth",
    "smoke:stdio": "tsx test/smoke.ts",
    "smoke:http": "tsx test/http-smoke.ts",
    "smoke:http-auth": "tsx test/http-auth-smoke.ts",
    "smoke:http-guardrails": "tsx test/http-guardrails.ts",
    "test:host-store": "tsx test/host-store.ts",
    "test:durable-state": "tsx test/durable-host-state.ts",
    "test:principal": "tsx test/principal.ts",
    "test:alpha-auth": "tsx test/alpha-auth.ts",
    "test:hardening": "tsx test/hardening.ts",
    "eval:golden": "tsx eval/golden.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "tsx": "^4.20.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0"
  }
}
