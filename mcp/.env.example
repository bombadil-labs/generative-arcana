# Non-secret reference only. Inject real values through approved secret management.
# The service reads process.env; copying this file does not automatically load it.
# Production origin must be HTTPS, exact, and have no path/query/fragment.
BETTER_AUTH_URL=https://generative-arcana.vercel.app

# Supply a random >=32-character secret OR a versioned key ring (not these placeholders).
# Do not deploy this file literally. Never put auth values in VITE_* variables.
BETTER_AUTH_SECRET=
# Set BETTER_AUTH_SECRET through secret management before starting; blank fails closed.
# Versioned rotation: newest first; preserve old keys until live ciphertext/backups are covered.
# BETTER_AUTH_SECRETS=2:REPLACE_WITH_NEW_RANDOM_SECRET,1:REPLACE_WITH_PREVIOUS_RANDOM_SECRET
# Keep BETTER_AUTH_SECRET only as needed for legacy ciphertext during an envelope transition.
# Rotating the current secret invalidates old browser cookies; plan re-login.

# Runtime DML-only connection for catalog, issuer/subject mapping, and shared HTTP limiter.
DATABASE_URL=postgresql://RUNTIME_ROLE:REPLACE_PASSWORD@REPLACE_NEON_HOST/REPLACE_DATABASE?sslmode=require
# Optional distinct auth runtime connection; defaults to DATABASE_URL.
# BETTER_AUTH_DATABASE_URL=postgresql://AUTH_RUNTIME_ROLE:REPLACE_PASSWORD@REPLACE_AUTH_HOST/REPLACE_DATABASE?sslmode=require

# Issuer is derived as BETTER_AUTH_URL + /api/auth. Resource must match exactly.
MCP_OAUTH_RESOURCE=https://generative-arcana.vercel.app/mcp
# If set, MCP_OAUTH_ISSUER must equal https://generative-arcana.vercel.app/api/auth
# Self-hosted mode fixes deck scopes to decks:read and decks:write.
# Do not configure MCP_ALPHA_TOKEN at the same time.

# Choose ONE server-only email configuration. Never use VITE_* for mail credentials.
# Resend via Vercel Marketplace: the integration injects both variables; no copied key needed.
# Verify the exact sending domain in Resend before use. Syntax validation is not verification.
# With bombadil.pub, the sender is Generative Arcana <noreply@bombadil.pub>.
# RESEND_API_KEY=REPLACE_WITH_INJECTED_RESEND_API_KEY
# RESEND_EMAIL_DOMAIN=bombadil.pub
# All six SMTP_* variables below must be absent for the Resend fallback, not merely blank.
#
# Alternative: explicit SMTP. Any variable below selects this path; incomplete config fails.
# SMTP_HOST and SMTP_FROM are required. User/password are supplied together if needed.
# 587 + false requires STARTTLS; 465 + true uses implicit TLS.
# SMTP_HOST=REPLACE_SMTP_HOST
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_FROM=Generative Arcana <accounts@REPLACE_VERIFIED_SENDER_DOMAIN>
# SMTP_USER=REPLACE_SMTP_USER
# SMTP_PASSWORD=REPLACE_SMTP_PASSWORD

# Production signing key rotation defaults: 30 days, with 1-day old-key overlap.
# Grace must cover the 300-second resource access-token lifetime; keep cache/skew allowance too.
BETTER_AUTH_JWKS_ROTATION_SECONDS=2592000
BETTER_AUTH_JWKS_GRACE_SECONDS=86400

HOST=0.0.0.0
PORT=3000
MCP_ALLOWED_HOSTS=generative-arcana.vercel.app
MCP_ALLOWED_ORIGINS=generative-arcana.vercel.app
ARCANA_WEB_DIST_DIR=/srv/app/dist
MCP_MAX_REQUEST_BYTES=4000000
MCP_RATE_LIMIT_PER_MINUTE=120
# ARCANA_BUILD_SHA=REPLACE_WITH_FULL_TESTED_COMMIT_SHA
# ARCANA_BUILD_ID=REPLACE_WITH_DEPLOYMENT_ID

# Operator process only. Never install a DDL-capable migration credential in the running service.
# DATABASE_MIGRATION_URL=postgresql://MIGRATOR_ROLE:REPLACE_PASSWORD@REVIEWED_HOST/REPLACE_DATABASE?sslmode=require
# Auth schema plan/apply uses BETTER_AUTH_DATABASE_URL or DATABASE_URL from that operator process.
# See ../docs/better-auth-deployment.md before running any migration.
