# Copy to mcp/fly.toml, replace YOUR_APP_NAME, then deploy from the repository root:
#   fly apps create YOUR_APP_NAME
#   fly volumes create arcana_state --region iad --size 1
#   fly secrets set MCP_ALPHA_TOKEN='replace-with-a-long-random-secret'
#   fly deploy . --config mcp/fly.toml

app = "YOUR_APP_NAME"
primary_region = "iad"
kill_signal = "SIGTERM"
kill_timeout = "5s"

[build]
  dockerfile = "mcp/Dockerfile"

[env]
  HOST = "0.0.0.0"
  PORT = "3000"
  MCP_ALLOWED_HOSTS = "YOUR_APP_NAME.fly.dev"
  MCP_STATE_DIR = "/data/arcana"
  MCP_ALPHA_PRINCIPAL_ID = "private-alpha-user-v1"

[mounts]
  source = "arcana_state"
  destination = "/data"

[http_service]
  internal_port = 3000
  force_https = true
  auto_stop_machines = "stop"
  auto_start_machines = true
  min_machines_running = 0

[[http_service.checks]]
  grace_period = "10s"
  interval = "30s"
  method = "GET"
  timeout = "5s"
  path = "/healthz"
